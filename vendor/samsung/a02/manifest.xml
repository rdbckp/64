<?xml version="1.0" encoding="UTF-8"?>
<!--
VINTF Manifest for Samsung Galaxy A02 64-bit Vendor Partition
Copy to: vendor/samsung/a02/manifest.xml

This file declares all HALs and system interfaces available from the vendor partition.
Required for Treble compliance and GSI system image compatibility.

target-level="30" = Android 11, VNDK version 30
-->
<manifest version="2.0" type="vendor" target-level="30">

  <!-- ============================================================
       Graphics (Gralloc) HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.graphics.allocator</n>
    <transport>hwbinder</transport>
    <version>3.0</version>
    <interface>
      <n>IAllocator</n>
      <instance>default</instance>
    </interface>
  </hal>

  <hal format="hidl">
    <n>android.hardware.graphics.composer</n>
    <transport>hwbinder</transport>
    <version>2.1</version>
    <interface>
      <n>IComposer</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Power Management HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.power</n>
    <transport>hwbinder</transport>
    <version>1.2</version>
    <interface>
      <n>IPower</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Lights (LED/Backlight) HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.lights</n>
    <transport>hwbinder</transport>
    <version>2.0</version>
    <interface>
      <n>ILight</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Vibrator HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.vibrator</n>
    <transport>hwbinder</transport>
    <version>1.3</version>
    <interface>
      <n>IVibrator</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Radio (Modem/RIL) HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.radio</n>
    <transport>hwbinder</transport>
    <version>1.5</version>
    <interface>
      <n>IRadio</n>
      <instance>slot1</instance>
    </interface>
    <interface>
      <n>ISap</n>
      <instance>slot1</instance>
    </interface>
  </hal>

  <!-- ============================================================
       WiFi HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.wifi</n>
    <transport>hwbinder</transport>
    <version>1.4</version>
    <interface>
      <n>IWifi</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Bluetooth HAL
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.bluetooth</n>
    <transport>hwbinder</transport>
    <version>1.1</version>
    <interface>
      <n>IBluetoothHci</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Thermal Management (Optional)
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.thermal</n>
    <transport>hwbinder</transport>
    <version>2.0</version>
    <interface>
      <n>IThermal</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Keymaster HAL (WAJIB - tanpa ini vold/keystore2 gagal,
       device stuck di boot animation atau gagal decrypt /data)
       Pakai versi software/default dulu sampai blob asli MediaTek
       tersedia di Phase 2.
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.keymaster</n>
    <transport>hwbinder</transport>
    <version>4.1</version>
    <interface>
      <n>IKeymasterDevice</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Gatekeeper HAL (WAJIB - dipakai buat lockscreen credential
       & tied ke Keymaster di atas)
       ============================================================ -->
  <hal format="hidl">
    <n>android.hardware.gatekeeper</n>
    <transport>hwbinder</transport>
    <version>1.0</version>
    <interface>
      <n>IGatekeeper</n>
      <instance>default</instance>
    </interface>
  </hal>

  <!-- ============================================================
       Audio HAL (MediaTek-specific)
       ============================================================ -->
  <!-- NOTE: Actual audio HAL blob will be added in Phase 2
  <hal format="hidl">
    <n>android.hardware.audio</n>
    <transport>hwbinder</transport>
    <version>6.0</version>
    <interface>
      <n>IDevicesFactory</n>
      <instance>default</instance>
    </interface>
  </hal>
  -->

  <!-- ============================================================
       Camera HAL (MediaTek-specific ISP)
       ============================================================ -->
  <!-- NOTE: Camera ISP blob will be added in Phase 2 after GPU works
  <hal format="hidl">
    <n>android.hardware.camera.provider</n>
    <transport>hwbinder</transport>
    <version>2.4</version>
    <interface>
      <n>ICameraProvider</n>
      <instance>0</instance>
    </interface>
  </hal>
  -->

  <!-- ============================================================
       SELinux Compatibility Information
       ============================================================ -->
  <sepolicy>
    <version>30.0</version>
  </sepolicy>

</manifest>
